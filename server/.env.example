# Ravelry API Credentials
# Get your API keys from https://www.ravelry.com/pro/developer
RAVELRY_USERNAME=your_ravelry_username
RAVELRY_PASSWORD=your_ravelry_password
RAVELRY_API_KEY=your_api_key

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:4200

# API Base URL
RAVELRY_API_URL=https://api.ravelry.com
