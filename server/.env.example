# Ravelry API Credentials (from https://www.ravelry.com/pro/developer)
# Access key = Basic Auth username AND OAuth client_id
RAVELRY_ACCESS_KEY=your_access_key
# Secret key = Basic Auth password AND OAuth client_secret
RAVELRY_SECRET_KEY=your_secret_key

# OAuth 2.0 - redirect URI must match what is registered in your Ravelry Pro app
RAVELRY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session
SESSION_SECRET=change-this-to-a-random-secret

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:4200

# API Base URL
RAVELRY_API_URL=https://api.ravelry.com
